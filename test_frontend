<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>상벌점 은행</title>
  <!-- Tailwind CSS를 활용하여 모바일 친화적이고 깔끔한 UI 구성 -->
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* 로딩 스피너 애니메이션 */
    .loader {
      border: 3px solid #f3f3f3;
      border-radius: 50%;
      border-top: 3px solid #3498db;
      width: 20px;
      height: 20px;
      -webkit-animation: spin 1s linear infinite; /* Safari */
      animation: spin 1s linear infinite;
      display: inline-block;
      vertical-align: middle;
      margin-left: 8px;
    }
    @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    
    /* 모달 배경 흐림 효과 */
    .modal-overlay { background-color: rgba(0, 0, 0, 0.5); }
    [x-cloak] { display: none !important; }
  </style>
</head>
<body class="bg-gray-100 text-gray-800 font-sans antialiased pb-20">

  <!-- 상단 네비게이션바 (탭) -->
  <nav class="bg-white shadow-md sticky top-0 z-10">
    <div class="max-w-md mx-auto px-4">
      <div class="flex justify-around text-center border-b border-gray-200">
        <button onclick="switchTab('input')" id="tab-input" class="w-1/2 py-4 text-blue-600 border-b-2 border-blue-600 font-semibold transition-colors">
          입력하기
        </button>
        <button onclick="switchTab('dashboard')" id="tab-dashboard" class="w-1/2 py-4 text-gray-500 hover:text-blue-500 font-semibold transition-colors">
          조회하기
        </button>
      </div>
    </div>
  </nav>

  <!-- 메인 컨테이너 -->
  <main class="max-w-md mx-auto p-4 mt-2">

    <!-- 1. 입력하기 화면 -->
    <section id="view-input" class="block">
      <div class="bg-white rounded-xl shadow-sm p-6">
        <h2 class="text-xl font-bold mb-5 text-gray-800">상벌점 입력</h2>
        
        <form id="transactionForm" onsubmit="handleFormSubmit(event)">
          <!-- 학생 선택 (다중 선택 구조로 수정됨) -->
          <div class="mb-4">
            <div class="flex justify-between items-end mb-1">
              <label class="block text-sm font-medium text-gray-700">학생 선택 <span class="text-xs text-blue-500 font-normal">(다중 선택 가능)</span></label>
              <button type="button" onclick="selectAllStudents()" class="text-xs text-gray-500 hover:text-blue-600 border px-2 py-1 rounded bg-white transition-colors">전체선택</button>
            </div>
            <div id="studentSelectContainer" class="flex flex-wrap gap-2 max-h-40 overflow-y-auto p-3 border border-gray-300 rounded-lg bg-gray-50">
              <div class="text-sm text-gray-500 text-center w-full">로딩 중...</div>
            </div>
          </div>

          <!-- 날짜 선택 -->
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">날짜</label>
            <input type="date" id="dateInput" required class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-blue-500">
          </div>

          <!-- 상벌점 구분 (라디오 버튼) -->
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-2">구분</label>
            <div class="flex gap-4">
              <label class="flex-1 cursor-pointer">
                <input type="radio" name="type" value="상점(입금)" checked class="peer sr-only">
                <div class="text-center p-3 rounded-lg border border-gray-300 peer-checked:bg-blue-50 peer-checked:border-blue-500 peer-checked:text-blue-700 font-medium transition">
                  상점 (입금)
                </div>
              </label>
              <label class="flex-1 cursor-pointer">
                <input type="radio" name="type" value="벌점(출금)" class="peer sr-only">
                <div class="text-center p-3 rounded-lg border border-gray-300 peer-checked:bg-red-50 peer-checked:border-red-500 peer-checked:text-red-700 font-medium transition">
                  벌점 (출금)
                </div>
              </label>
            </div>
          </div>

          <!-- 사유 입력 -->
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">내용 (사유)</label>
            <input type="text" id="reasonInput" required placeholder="예: 숙제 우수, 지각 등" class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-blue-500">
          </div>

          <!-- 점수 입력 -->
          <div class="mb-6">
            <label class="block text-sm font-medium text-gray-700 mb-1">점수</label>
            <input type="number" id="scoreInput" required min="1" placeholder="숫자만 입력 (예: 5)" class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-blue-500">
            <p class="text-xs text-gray-500 mt-1">* 벌점을 선택하면 자동으로 차감됩니다.</p>
          </div>

          <!-- 제출 버튼 -->
          <button type="submit" id="submitBtn" class="w-full bg-blue-600 text-white font-bold py-3 px-4 rounded-lg hover:bg-blue-700 transition flex justify-center items-center">
            <span>입력 완료</span>
            <div id="loadingSpinner" class="loader hidden"></div>
          </button>
        </form>
      </div>
    </section>

    <!-- 2. 조회하기 화면 -->
    <section id="view-dashboard" class="hidden">
      <div class="flex justify-between items-center mb-4 px-1">
        <h2 class="text-xl font-bold text-gray-800">학생 잔액 현황</h2>
        <button onclick="loadStudentData()" class="text-sm text-blue-600 hover:text-blue-800 flex items-center">
          새로고침 ↻
        </button>
      </div>
      
      <!-- 학생 목록 리스트가 여기에 렌더링 됩니다 -->
      <div id="studentListContainer" class="grid gap-3">
        <div class="text-center py-10 text-gray-500">데이터를 불러오는 중입니다...</div>
      </div>
    </section>

  </main>

  <!-- 3. 상세 조회 모달 -->
  <div id="detailModal" class="fixed inset-0 modal-overlay z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-sm mx-4 max-h-[80vh] flex flex-col transform scale-95 transition-transform duration-300" id="modalContent">
      
      <!-- 모달 헤더 -->
      <div class="p-5 border-b border-gray-200 flex justify-between items-center bg-gray-50 rounded-t-xl">
        <div>
          <h3 id="modalStudentName" class="text-lg font-bold text-gray-800">이름</h3>
          <p id="modalStudentScore" class="text-sm font-medium mt-1">총 0점</p>
        </div>
        <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600 text-2xl font-bold p-2">&times;</button>
      </div>

      <!-- 모달 내용 (거래 내역) -->
      <div class="p-0 overflow-y-auto flex-1 bg-white" id="modalHistoryContent">
        <div class="text-center py-10 text-gray-500">내역을 불러오는 중입니다...</div>
      </div>

      <!-- 모달 하단 -->
      <div class="p-4 border-t border-gray-200">
        <button onclick="closeModal()" class="w-full bg-gray-200 text-gray-800 font-bold py-2 rounded-lg hover:bg-gray-300 transition">닫기</button>
      </div>
    </div>
  </div>


  <!-- =============================== -->
  <!-- 자바스크립트 로직 -->
  <!-- =============================== -->
  <script>
    // 전역 변수로 학생 데이터 보관
    let studentsData = [];
    let selectedStudents = []; // 다중 선택된 학생 목록 보관용

    // 1. 페이지 로드 시 초기화
    document.addEventListener("DOMContentLoaded", () => {
      // 오늘 날짜 기본 세팅
      document.getElementById('dateInput').value = new Date().toISOString().split('T')[0];
      // 학생 데이터 불러오기
      loadStudentData();
    });

    // 2. 탭 전환 로직
    function switchTab(tab) {
      const inputView = document.getElementById('view-input');
      const dashboardView = document.getElementById('view-dashboard');
      const tabInput = document.getElementById('tab-input');
      const tabDashboard = document.getElementById('tab-dashboard');

      if (tab === 'input') {
        inputView.classList.remove('hidden');
        dashboardView.classList.add('hidden');
        tabInput.classList.add('text-blue-600', 'border-blue-600');
        tabInput.classList.remove('text-gray-500', 'border-transparent');
        tabDashboard.classList.remove('text-blue-600', 'border-blue-600');
        tabDashboard.classList.add('text-gray-500', 'border-transparent');
      } else {
        inputView.classList.add('hidden');
        dashboardView.classList.remove('hidden');
        tabDashboard.classList.add('text-blue-600', 'border-blue-600');
        tabDashboard.classList.remove('text-gray-500', 'border-transparent');
        tabInput.classList.remove('text-blue-600', 'border-blue-600');
        tabInput.classList.add('text-gray-500', 'border-transparent');
      }
    }

    // 3. 앱 스크립트에서 학생 데이터 불러오기
    function loadStudentData() {
      // 로딩 UI 처리
      document.getElementById('studentSelectContainer').innerHTML = '<div class="text-sm text-gray-500 text-center w-full">데이터 불러오는 중...</div>';
      document.getElementById('studentListContainer').innerHTML = '<div class="text-center py-10 text-gray-500">데이터를 불러오는 중입니다...</div>';
      selectedStudents = []; // 갱신 시 선택 초기화

      // Apps Script 서버 함수 호출
      google.script.run
        .withSuccessHandler(renderStudents)
        .withFailureHandler(handleError)
        .getStudentList();
    }

    // 데이터 불러오기 성공 시 렌더링
    function renderStudents(data) {
      studentsData = data;
      
      // Select Box 대신 클릭 가능한 Chip(버튼) 형태로 렌더링
      const selectContainer = document.getElementById('studentSelectContainer');
      selectContainer.innerHTML = '';
      
      // Dashboard List 렌더링
      const listContainer = document.getElementById('studentListContainer');
      listContainer.innerHTML = '';

      if (data.length === 0) {
        selectContainer.innerHTML = '<div class="text-sm text-gray-500 text-center w-full">등록된 학생이 없습니다.</div>';
        listContainer.innerHTML = '<div class="text-center py-10 text-gray-500">등록된 학생이 없습니다.</div>';
        return;
      }

      data.forEach(student => {
        // 다중 선택 버튼(Chip) 추가
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = "student-chip px-3 py-1.5 rounded-full border border-gray-300 bg-white text-sm text-gray-700 font-medium transition-colors hover:bg-gray-100";
        chip.textContent = `${student.name}`;
        chip.onclick = () => toggleStudentSelection(chip, student.id, student.name);
        selectContainer.appendChild(chip);

        // 조회하기 카드 추가
        const scoreClass = student.score >= 0 ? 'text-blue-600 bg-blue-50' : 'text-red-600 bg-red-50';
        const card = document.createElement('div');
        card.className = "bg-white p-4 rounded-xl shadow-sm border border-gray-100 flex justify-between items-center cursor-pointer hover:shadow-md transition active:scale-95";
        card.onclick = () => openModal(student.id, student.name, student.score);
        
        card.innerHTML = `
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center text-gray-600 font-bold text-sm">
              ${student.id}
            </div>
            <div class="font-bold text-gray-800">${student.name}</div>
          </div>
          <div class="font-bold text-lg px-3 py-1 rounded-lg ${scoreClass}">
            ${student.score} 점
          </div>
        `;
        listContainer.appendChild(card);
      });
    }

    // 학생 다중 선택/해제 토글 함수 (새로 추가)
    function toggleStudentSelection(btnElement, id, name) {
      const index = selectedStudents.findIndex(s => s.id === id);
      if (index === -1) {
        // 선택 추가 처리 (파란색으로 변경)
        selectedStudents.push({ id, name });
        btnElement.classList.replace('bg-white', 'bg-blue-500');
        btnElement.classList.replace('text-gray-700', 'text-white');
        btnElement.classList.replace('border-gray-300', 'border-blue-500');
        btnElement.classList.remove('hover:bg-gray-100');
      } else {
        // 선택 해제 처리 (원래대로 복구)
        selectedStudents.splice(index, 1);
        btnElement.classList.replace('bg-blue-500', 'bg-white');
        btnElement.classList.replace('text-white', 'text-gray-700');
        btnElement.classList.replace('border-blue-500', 'border-gray-300');
        btnElement.classList.add('hover:bg-gray-100');
      }
    }

    // 전체 선택/해제 기능 (새로 추가)
    function selectAllStudents() {
      const chips = document.querySelectorAll('.student-chip');
      if (selectedStudents.length === studentsData.length) {
        // 모두 선택되어 있으면 전체 해제
        selectedStudents = [];
        chips.forEach(chip => {
          chip.classList.replace('bg-blue-500', 'bg-white');
          chip.classList.replace('text-white', 'text-gray-700');
          chip.classList.replace('border-blue-500', 'border-gray-300');
          chip.classList.add('hover:bg-gray-100');
        });
      } else {
        // 전체 선택
        selectedStudents = studentsData.map(s => ({ id: s.id, name: s.name }));
        chips.forEach(chip => {
          chip.classList.replace('bg-white', 'bg-blue-500');
          chip.classList.replace('text-gray-700', 'text-white');
          chip.classList.replace('border-gray-300', 'border-blue-500');
          chip.classList.remove('hover:bg-gray-100');
        });
      }
    }

    // 4. 폼 제출 (데이터 저장)
    function handleFormSubmit(event) {
      event.preventDefault(); // 페이지 새로고침 방지
      
      if (selectedStudents.length === 0) {
        alert("최소 한 명 이상의 학생을 선택해주세요.");
        return;
      }
      
      // 전송할 데이터 객체 만들기 (배열로 전송)
      const formData = {
        students: selectedStudents,
        date: document.getElementById('dateInput').value,
        type: document.querySelector('input[name="type"]:checked').value,
        reason: document.getElementById('reasonInput').value,
        score: document.getElementById('scoreInput').value
      };

      // UI 로딩 상태 변경
      const btn = document.getElementById('submitBtn');
      const spinner = document.getElementById('loadingSpinner');
      btn.disabled = true;
      btn.classList.add('opacity-70');
      spinner.classList.remove('hidden');

      // 서버로 전송
      google.script.run
        .withSuccessHandler(() => {
          // 성공 처리
          btn.disabled = false;
          btn.classList.remove('opacity-70');
          spinner.classList.add('hidden');
          
          alert(`${formData.students.length}명의 학생 내역이 저장되었습니다.`);
          
          // 폼 초기화 (날짜, 타입은 유지)
          document.getElementById('reasonInput').value = '';
          document.getElementById('scoreInput').value = '';
          
          // 선택된 학생 초기화 및 버튼 스타일 원상복구
          selectedStudents = [];
          document.querySelectorAll('.student-chip').forEach(chip => {
            chip.classList.replace('bg-blue-500', 'bg-white');
            chip.classList.replace('text-white', 'text-gray-700');
            chip.classList.replace('border-blue-500', 'border-gray-300');
            chip.classList.add('hover:bg-gray-100');
          });
          
          // 백그라운드에서 최신 데이터 다시 불러오기
          loadStudentData();
        })
        .withFailureHandler(err => {
          handleError(err);
          btn.disabled = false;
          btn.classList.remove('opacity-70');
          spinner.classList.add('hidden');
        })
        .addTransaction(formData);
    }

    // 5. 모달 제어 및 상세 내역 불러오기
    function openModal(studentId, studentName, currentScore) {
      const modal = document.getElementById('detailModal');
      const modalContent = document.getElementById('modalContent');
      
      // 헤더 세팅
      document.getElementById('modalStudentName').textContent = `${studentId}번 ${studentName}의 장부`;
      const scoreEl = document.getElementById('modalStudentScore');
      scoreEl.textContent = `현재 잔액: ${currentScore}점`;
      scoreEl.className = currentScore >= 0 ? "text-sm font-bold mt-1 text-blue-600" : "text-sm font-bold mt-1 text-red-600";

      // 내용 로딩 초기화
      document.getElementById('modalHistoryContent').innerHTML = '<div class="text-center py-10 text-gray-500">내역을 불러오는 중입니다...</div>';

      // 모달 애니메이션 표시
      modal.classList.remove('hidden');
      // 약간의 지연 후 투명도 및 크기 조절하여 애니메이션 효과
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        modalContent.classList.remove('scale-95');
      }, 10);

      // 서버에 내역 요청
      google.script.run
        .withSuccessHandler(renderHistory)
        .withFailureHandler(handleError)
        .getStudentHistory(studentId);
    }

    function renderHistory(historyData) {
      const container = document.getElementById('modalHistoryContent');
      container.innerHTML = '';

      if (historyData.length === 0) {
        container.innerHTML = '<div class="text-center py-10 text-gray-500">상벌점 내역이 없습니다.</div>';
        return;
      }

      // 리스트 렌더링
      const ul = document.createElement('ul');
      ul.className = "divide-y divide-gray-100";
      
      historyData.forEach(item => {
        const isReward = item.type.includes('상점');
        const scoreColor = isReward ? 'text-blue-600' : 'text-red-600';
        const sign = isReward ? '+' : '';
        
        const li = document.createElement('li');
        li.className = "p-4 hover:bg-gray-50 flex justify-between items-center";
        li.innerHTML = `
          <div>
            <div class="text-xs text-gray-500 mb-1">${item.date}</div>
            <div class="font-medium text-gray-800">${item.reason}</div>
          </div>
          <div class="font-bold text-lg ${scoreColor} bg-white px-2 py-1 rounded shadow-sm border border-gray-100">
            ${sign}${item.score}
          </div>
        `;
        ul.appendChild(li);
      });

      container.appendChild(ul);
    }

    function closeModal() {
      const modal = document.getElementById('detailModal');
      const modalContent = document.getElementById('modalContent');
      
      // 모달 애니메이션 숨기기
      modal.classList.add('opacity-0');
      modalContent.classList.add('scale-95');
      
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 300); // transition 시간과 동일하게 대기
    }

    // 에러 핸들링
    function handleError(error) {
      console.error(error);
      alert('오류가 발생했습니다: ' + error.message);
    }
  </script>
</body>
</html>
